{
  "name": "starci-skills-fe",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.6.2",
  "type": "module",
  "description": "Read-only console over the StarCi trust tree's machine-local state: workspace routes, design registries and sessions.",
  "scripts": {
    "start": "vite --host 127.0.0.1 --port 8090",
    "dev": "vite --host 127.0.0.1 --port 8090",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 8090",
    "lint": "eslint .",
    "lint:check": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:check": "node scripts/check-coverage.mjs",
    "e2e": "playwright test",
    "test:e2e": "playwright test",
    "sonar:check": "sonar-scanner-npm -Dsonar.qualitygate.wait=true",
    "sonar:wait": "node scripts/sonar-wait.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^2.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sonar/scan": "^5.0.0",
    "@starci/eslint-canon-fe": "^3.0.2",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "c8": "^12.0.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.9",
    "vitest": "^4.1.11"
  }
}
